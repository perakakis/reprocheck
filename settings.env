# Settings for this manuscript: the only file a checker edits.
# One KEY=value per line, no quotes, no spaces around "=".
# Fill these in after the authors' files are in manuscript/, then start the
# check from Actions > Reproduce > Run workflow.

# The R version the authors declared (paper, README, sessionInfo, renv.lock);
# if none, the release current on the deposit date. Releases and dates:
# https://cran.r-project.org/src/base/R-4/
R_VERSION=

# The day whose copy of CRAN the packages are installed from: the deposit
# date, or the day before the next R release if R_VERSION was superseded by
# then.
CRAN_SNAPSHOT=

# The script or scripts the authors' README says to run, relative to
# manuscript/. Several scripts are separated by commas and run in that order,
# each in a fresh R session, for example:
# ENTRY_SCRIPT=code/01_clean.R, code/02_analyse.R
ENTRY_SCRIPT=
